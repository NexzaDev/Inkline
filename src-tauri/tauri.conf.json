{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inkline",
  "version": "0.1.0",
  "identifier": "dev.nexza.inkline",
  "build": {
    "beforeDevCommand": "npm --prefix web/shell run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix web/shell run build",
    "frontendDist": "../web/shell/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkline",
        "width": 960,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Graph and diagram editor",
    "longDescription": "Inkline edits .graph documents on Android with connected cards, rich text, layers and pages.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
